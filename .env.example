NEXT_PUBLIC_MATCHBOX_SIGNALING_URL=wss://your-matchbox-host:3536
# JSON array of ICE servers - only the first entry is used. Defaults to
# STUN-only if unset, which is NOT enough for cross-device connections in
# many cases (symmetric NAT, or same-LAN peers behind a router without NAT
# hairpinning support). See rust/turn/README.md to run a TURN relay.
# NEXT_PUBLIC_MATCHBOX_ICE_SERVERS=[{"urls":["turn:your-turn-host:3478"],"username":"...","credential":"..."}]
