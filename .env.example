NEXT_PUBLIC_MATCHBOX_SIGNALING_URL=wss://your-matchbox-host:3536
# Optional: JSON array of ICE servers, e.g. a TURN server for peers behind
# restrictive NATs. Only the first entry is used. Defaults to STUN-only if unset.
# NEXT_PUBLIC_MATCHBOX_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
